# Azure Service Principal Configuration
# Create a service principal in Azure with Reader permissions
# and fill in the values below

# Service Principal Client ID (Application ID)
AZURE_CLIENT_ID=your-client-id-here

# Service Principal Client Secret
AZURE_CLIENT_SECRET=your-client-secret-here

# Azure Active Directory Tenant ID
AZURE_TENANT_ID=your-tenant-id-here

# Azure Subscription ID to scan
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Database Configuration
# Path to SQLite database file
DB_PATH=./scanner_azure.db

# Optional: Debug mode (set to true for verbose logging)
DEBUG=false

# Optional: Streamlit Configuration
# Uncomment and modify these if needed
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=false

# ============================================
# AWS Configuration (for AWS support)
# ============================================

# AWS Access Key ID (need IAM user with ReadOnlyAccess policy attached)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here

# AWS Region (default region for scanning, change if needed)
AWS_REGION=us-east-1